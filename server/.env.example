# Copy to server/.env. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/online_classroom
# Required: generate a random value of at least 32 characters before starting.
JWT_SECRET=
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://127.0.0.1:5173
# Relative paths are resolved from the server directory.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Only used by npm run seed:admin. Choose your own credentials.
# Password: at least 12 characters and at most 72 UTF-8 bytes.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
